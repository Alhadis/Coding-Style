# -*- mode: editorconfig; truncate-lines: nil; -*- vim:set ft=editorconfig wrap:

#
# Alhadis's master EditorConfig. Realistically, only a subset of
# relevant rules will appear in any project's “.editorconfig” file.
#
root = true

[*]
indent_style = tab
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false
quote_type = double
wildcard_import_limit = 8
continuation_indent_size = 0
curly_bracket_next_line = false
spaces_around_operators = false
spaces_around_brackets = hybrid
indent_brace_style = K&R
spelling_language = en-AU

# Git message logs
[{COMMIT_EDITMSG,MERGE_MSG}]
trim_trailing_whitespace = true
max_line_length = 72
indent_style = space
indent_size = 4

# Markdown
[*.{md,markdown,mk{d,dn,down}}]
trim_trailing_whitespace = false
indent_size = 4
tab_width = 4

# Ubiquitous project docs
[{LICENSE,README}.{md,txt}]
max_line_length = 80

# Lisp and Scheme
[*.{cl,el{,c,d},{,_,spac}emacs,[CE]ask{,file},lisp,lsp,sch,scm,sexp,rkt{,d,l,}}]
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Batch scripts
[*.{bat,btm,cmd}]
end_of_line = crlf

# YAML
[*.{clang-{format,tidy},{yaml,yml}{,-tmlanguage},rviz,{sublime-,}syntax}]
indent_style = space
indent_size = 4

# PostScript
[*.{ps,eps{,f,i},pfa,pfb,t1,t42,aia,kys}]
charset = latin1

# Adobe Font Metrics
[*.{afm,amfm,acfm,amm}]
charset = latin1
max_line_length = 255
line_comment = Comment

# SubRip Text
[*.srt]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = unset

# Tab-separated values
[*.tsv]
elastic_tabstops = true
trim_trailing_whitespace = false
indent_size = 8

# Emacs snippets
[*.{yasnippet,yas}]
insert_final_newline = false

# WebAssembly text format; too imperative for s-exp formatting
[*.{wat,wast}]
max_line_length = unset

# HTTP(S) headers
[*.http{,spec}]
end_of_line = crlf
insert_final_newline = unset

# Server file-listings generated by rsync(1)
[.listing]
end_of_line = crlf
indent_style = space

# Windows-related crap
[{Autorun.inf,desktop.ini,{,C,D,OD,FD,RX}CONFIG.SYS}]
end_of_line = crlf
indent_size = 8
insert_final_newline = unset

# WaReZ press releases
[*.NFO]
charset = cp437
end_of_line = crlf
indent_size = 2
indent_style = space
insert_final_newline = unset
max_line_length = 80
tab_width = 8
trim_trailing_whitespace = false
